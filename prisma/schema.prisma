generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────── ПОЛЬЗОВАТЕЛИ ───────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  fullName     String
  role         String // admin | responsible | executor
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  executor                 Executor?
  responsibleProjects      Project[]             @relation("ProjectResponsible")
  responsibleForExecutors  Executor[]            @relation("ExecutorResponsible")
  otherExpensesCreated     OtherExpense[]        @relation("OtherExpenseCreatedBy")
  otherExpensesResponsible OtherExpense[]        @relation("OtherExpenseResponsible")
  spendingPlanLinesCreated SpendingPlanLine[]    @relation("SpendingPlanLineCreatedBy")
  vacationApprovals        VacationEntry[]       @relation("VacationApprovedBy")
  activityLogs             ActivityLog[]
  cashflowCellComments     CashflowCellComment[]

  @@map("users")
}

// ─────────────────── ИСПОЛНИТЕЛИ ───────────────────

model Executor {
  id                   String       @id @default(cuid())
  userId               String?      @unique // сохраняется при отзыве доступа; не зависит от типа
  user                 User?        @relation(fields: [userId], references: [id])
  name                 String // computed по типу: "Фамилия Имя" / "Название ТипЮрлица" / UPPER для сервисов
  type                 String       @default("permanent") // permanent | external | service | bank
  companyStatus        String? // Ядро | Орбита (для permanent)
  legalForm            String? // legacy, не используется в UI
  recipientType        String? // физлицо | юрлицо | самозанятый | ...
  specialty            String?
  contractFile         String? // URL
  ndaFile              String? // URL
  inTgChat             Boolean      @default(false)
  contacts             String?
  requisites           String?
  note                 String?
  contactEmail         String?
  accessEmail          String?
  defaultBankAccountId String?
  defaultBankAccount   BankAccount? @relation("ExecutorDefaultBankAccount", fields: [defaultBankAccountId], references: [id])
  responsibleUserId    String?
  responsibleUser      User?        @relation("ExecutorResponsible", fields: [responsibleUserId], references: [id])
  isResponsible        Boolean      @default(false)
  responsibleActive    Boolean      @default(true) // статус ответственного (≠ Executor.status)
  oldEstimateUrl       String?
  specialties          String? // JSON array of segments
  status               String       @default("active") // active | archived
  accessRevokedAt      DateTime?
  onboardingSeeded     Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  projectExecutors             ProjectExecutor[]
  works                        Work[]
  worksResponsible             Work[]             @relation("WorkResponsible")
  payments                     Payment[]
  otherExpenses                OtherExpense[]
  otherExpensesResponsibleExec OtherExpense[]     @relation("OtherExpenseResponsibleExecutor")
  executorWorkTypes            ExecutorWorkType[]
  spendingPlanLines            SpendingPlanLine[]
  vacationEntries              VacationEntry[]
  tasks                        Task[]

  @@index([status])
  @@index([type])
  @@map("executors")
}

// ─────────────────── КЛИЕНТЫ ───────────────────

model Client {
  id         String   @id @default(cuid())
  name       String   @unique // computed: "{department} – {company}" (см. TDNB-21)
  company    String
  department String
  status     String   @default("active") // active | archived
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  projects Project[]

  @@map("clients")
}

// ─────────────────── ПРОЕКТЫ ───────────────────

model Project {
  id                String   @id @default(cuid())
  shortName         String // имя проекта без префикса клиента
  name              String // computed: "{client.name} – {shortName}"
  type              String // internal | client (computed по client.company)
  status            String   @default("active") // active | archived
  responsibleUserId String?
  responsible       User?    @relation("ProjectResponsible", fields: [responsibleUserId], references: [id])
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id])
  cashflowInitial   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  projectExecutors    ProjectExecutor[]
  projectWorkTypes    ProjectWorkType[]
  works               Work[]
  otherExpenses       OtherExpense[]
  orders              Order[]
  spendingPlanLines   SpendingPlanLine[]
  verificationResults ProjectVerificationResult[]

  @@unique([clientId, shortName])
  @@index([responsibleUserId])
  @@index([clientId])
  @@map("projects")
}

model ProjectWorkType {
  projectId  String
  workTypeId String
  project    Project  @relation(fields: [projectId], references: [id])
  workType   WorkType @relation(fields: [workTypeId], references: [id])

  @@id([projectId, workTypeId])
  @@map("project_work_types")
}

model ProjectExecutor {
  projectId  String
  executorId String
  project    Project  @relation(fields: [projectId], references: [id])
  executor   Executor @relation(fields: [executorId], references: [id])

  @@id([projectId, executorId])
  @@map("project_executors")
}

// ─────────────────── БАНКОВСКИЕ СЧЕТА ───────────────────

model BankAccount {
  id        String   @id @default(cuid())
  name      String   @unique
  details   String?
  currency  String   @default("RUB") // код валюты: RUB | USD | EUR | GEL | ...
  isDefault Boolean  @default(false) // единственный active с true (см. TDNB-23)
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments              Payment[]
  charges               Charge[]
  otherExpenses         OtherExpense[]
  bankOperations        BankOperation[]
  defaultForExecutors   Executor[]                        @relation("ExecutorDefaultBankAccount")
  reconciliationResults BankAccountReconciliationResult[]

  @@map("bank_accounts")
}

// ─────────────────── ВАЛЮТЫ (централизованный справочник) ───────────────────

model Currency {
  code      String   @id // ISO-подобный код: RUB, USD, EUR, GEL, ...
  createdAt DateTime @default(now())

  @@map("currencies")
}

// ─────────────────── ВИДЫ РАБОТ ───────────────────

model WorkType {
  id      String @id @default(cuid())
  name    String @unique
  segment String // Транзитные платежи | Видео | Аналитика | Продвижение | Экспертиза | Сервисы | Менеджмент | Визуал | Текст | IT
  status  String @default("active") // active | archived

  works             Work[]
  otherExpenses     OtherExpense[]
  executorWorkTypes ExecutorWorkType[]
  projectWorkTypes  ProjectWorkType[]
  spendingPlanLines SpendingPlanLine[]

  @@map("work_types")
}

model ExecutorWorkType {
  executorId String
  workTypeId String
  executor   Executor @relation(fields: [executorId], references: [id])
  workType   WorkType @relation(fields: [workTypeId], references: [id])

  @@id([executorId, workTypeId])
  @@map("executor_work_types")
}

// ─────────────────── РАБОТЫ (Личная смета) ───────────────────

model Work {
  id                     String    @id @default(cuid())
  issuedWorkNumber       String?   @unique
  issuedWorkNumberYear   Int?
  issuedWorkNumberSerial Int?
  projectId              String
  project                Project   @relation(fields: [projectId], references: [id])
  executorId             String
  executor               Executor  @relation(fields: [executorId], references: [id])
  workTypeId             String
  workType               WorkType  @relation(fields: [workTypeId], references: [id])
  executionYear          Int
  executionMonth         Int
  techTask               String? // ТЗ — текст
  report                 String? // URL отчёта
  link                   String? // URL произвольная ссылка
  volume                 Float?
  rate                   Float?
  amount                 Float // Сумма к выплате
  plannedPayAt           DateTime? // Дата оплаты — план (раздельная с Payment)
  paidAt                 DateTime?
  workStatus             String    @default("submitted") // submitted | checked | paid | rework
  checkedAt              DateTime? // Дата проверки
  comment                String?

  // Ответственный (KPD-284): любой активный постоянный исполнитель; по умолчанию = РП проекта
  responsibleExecutorId String?
  responsibleExecutor   Executor? @relation("WorkResponsible", fields: [responsibleExecutorId], references: [id])

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuedWorkNumberYear, issuedWorkNumberSerial])
  @@index([executorId, executionYear, executionMonth])
  @@index([projectId])
  @@index([workStatus])
  @@index([responsibleExecutorId])
  @@map("works")
}

// ─────────────────── ВЫПЛАТЫ ───────────────────

model Payment {
  id                 String       @id @default(cuid())
  payoutNumber       String?      @unique
  payoutNumberYear   Int?
  payoutNumberSerial Int?
  executorId         String
  executor           Executor     @relation(fields: [executorId], references: [id])
  periodYear         Int
  periodMonth        Int
  amount             Float
  paymentStatus      String       @default("planned") // planned | paid
  plannedPayAt       DateTime?
  paidAt             DateTime?
  bankAccountId      String?
  bankAccount        BankAccount? @relation(fields: [bankAccountId], references: [id])
  comment            String?
  filledTechTask     String? // URL «Заполненное ТЗ»
  filledAct          String? // URL «Заполненный акт»
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  works Work[]

  @@unique([payoutNumberYear, payoutNumberSerial])
  @@index([executorId, periodYear, periodMonth])
  @@index([paymentStatus])
  @@map("payments")
}

// ─────────────────── ПРОЧИЕ ТРАТЫ ───────────────────

model OtherExpense {
  id                       String       @id @default(cuid())
  sourceUid                String?      @unique
  otherExpenseNumber       String?      @unique
  otherExpenseNumberYear   Int?
  otherExpenseNumberSerial Int?
  issuedWorkNumber         String?      @unique
  issuedWorkNumberYear     Int?
  issuedWorkNumberSerial   Int?
  payoutNumber             String?      @unique
  payoutNumberYear         Int?
  payoutNumberSerial       Int?
  projectId                String
  project                  Project      @relation(fields: [projectId], references: [id])
  executorId               String
  executor                 Executor     @relation(fields: [executorId], references: [id])
  workTypeId               String
  workType                 WorkType     @relation(fields: [workTypeId], references: [id])
  // legacy «Ответственный»-пользователь (оставлен для совместимости/миграции)
  responsibleUserId        String?
  responsibleUser          User?        @relation("OtherExpenseResponsible", fields: [responsibleUserId], references: [id])
  // Ответственный (KPD-285): активный постоянный исполнитель
  responsibleExecutorId    String?
  responsibleExecutor      Executor?    @relation("OtherExpenseResponsibleExecutor", fields: [responsibleExecutorId], references: [id])
  bankAccountId            String?
  bankAccount              BankAccount? @relation(fields: [bankAccountId], references: [id])
  executionYear            Int
  executionMonth           Int
  description              String
  amount                   Float
  paymentAmount            Float?
  plannedPayAt             DateTime?
  paidAt                   DateTime?
  checkedAt                DateTime?
  workStatus               String       @default("submitted") // submitted | checked | paid | rework
  paymentStatus            String? // planned | paid | null (null = ожидает проверки)
  preferredPayMethod       String?
  comment                  String?
  createdById              String
  createdBy                User         @relation("OtherExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@unique([otherExpenseNumberYear, otherExpenseNumberSerial])
  @@unique([issuedWorkNumberYear, issuedWorkNumberSerial])
  @@unique([payoutNumberYear, payoutNumberSerial])
  @@index([projectId])
  @@index([executorId])
  @@index([responsibleUserId])
  @@index([responsibleExecutorId])
  @@index([workStatus])
  @@index([paymentStatus])
  @@map("other_expenses")
}

model NumberCounter {
  scope     String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([scope, year])
  @@map("number_counters")
}

// ─────────────────── ЗАКАЗЫ ───────────────────

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique // З001, З002, ... (см. TDNB-19)
  description    String?
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  contractNumber String?
  status         String   @default("active") // active | archived
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  charges Charge[]

  @@map("orders")
}

// ─────────────────── НАЧИСЛЕНИЯ ───────────────────

model Charge {
  id             String       @id @default(cuid())
  chargeNumber   String       @unique // Н001, Н002, ... (см. TDNB-20)
  bankAccountId  String?
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id])
  invoiceNumber  String?      @unique // № счёта (см. TDNB-20)
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  amount         Float        @default(0)
  issuedPlanAt   DateTime?
  issuedAt       DateTime?
  paidPlanAt     DateTime?
  paidAt         DateTime?
  paymentPurpose String?
  status         String       @default("planned") // planned | issued | paid | overdue
  documents      String? // URL
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([bankAccountId])
  @@index([orderId])
  @@index([status])
  @@map("charges")
}

// ─────────────────── БАНКОВСКИЕ ОПЕРАЦИИ (заглушка — заполняется через «Робот») ───────────────────

model BankOperation {
  id            String      @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  amount        Float
  date          DateTime
  kind          String // incoming | outgoing
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([bankAccountId])
  @@index([date])
  @@map("bank_operations")
}

// ─────────────────── ПЛАН РАСХОДОВ ───────────────────

model SpendingPlanLine {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  executorId  String // обязательно (TDNB-29 §Блок 4)
  executor    Executor @relation(fields: [executorId], references: [id])
  workTypeId  String // обязательно (TDNB-29 §Блок 4)
  workType    WorkType @relation(fields: [workTypeId], references: [id])
  year        Int
  week        Int
  amount      Float
  sourceType  String? // "personal" | "other"
  comment     String?
  createdById String
  createdBy   User     @relation("SpendingPlanLineCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, year, week])
  @@map("spending_plan_lines")
}

// ─────────────────── ОТПУСКА ───────────────────

model VacationEntry {
  id                 String    @id @default(cuid())
  executorId         String
  executor           Executor  @relation(fields: [executorId], references: [id])
  startAt            DateTime
  endAt              DateTime
  daysCount          Int
  secondStartAt      DateTime?
  secondEndAt        DateTime?
  secondDaysCount    Int?
  substituteContacts String?
  status             String    @default("need_approval") // need_approval | approved
  isPaid             Boolean   @default(false)
  approvedById       String?
  approvedBy         User?     @relation("VacationApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([executorId])
  @@index([status])
  @@map("vacation_entries")
}

// ─────────────────── ЗАДАЧИ ───────────────────

model Task {
  id            String    @id @default(cuid())
  executorId    String
  executor      Executor  @relation(fields: [executorId], references: [id])
  title         String
  status        String    @default("pending") // pending | in_progress | paused | review | done
  plannedDoneAt DateTime?
  result        String?
  comment       String?
  isOnboarding  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([executorId, status])
  @@map("tasks")
}

// ─────────────────── СТАРТОВЫЙ БАЛАНС КЭШФЛОУ ───────────────────

model CashflowOpeningBalance {
  year      Int      @id
  amount    Float
  updatedAt DateTime @updatedAt

  @@map("cashflow_opening_balances")
}

model CashflowCellComment {
  id          String   @id @default(cuid())
  year        Int
  week        Int
  rowKey      String
  text        String   @default("")
  highlight   String? // yellow | green | red
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year, week, rowKey])
  @@index([year, week])
  @@map("cashflow_cell_comments")
}

// ─────────────────── ИСТОРИЯ ДЕЙСТВИЙ (audit log) ───────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String // create | update | delete | archive | status_change | ...
  entityType  String
  entityId    String
  entityLabel String?
  changes     String? // JSON-сериализованный diff: {field: {from, to}}
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─────────────────── ЕЖЕДНЕВНЫЕ СНИМКИ ───────────────────

model SnapshotRun {
  id             String    @id @default(cuid())
  businessDate   DateTime
  cutoffAt       DateTime
  startedAt      DateTime
  completedAt    DateTime?
  status         String    @default("pending") // pending | running | completed | failed
  runKind        String    @default("scheduled") // scheduled | manual
  scheduleKey    String?   @unique // идемпотентность планового запуска; null для ручных снимков
  executionLock  String?   @unique // общий lock создания; очищается после завершения
  timezone       String    @default("Europe/Moscow")
  schemaVersion  Int
  schemaHash     String
  appCommit      String?
  formulaVersion String
  rowCounts      String? // JSON: model -> row count
  byteSize       Int?
  contentHash    String?
  objectPrefix   String?
  manifestKey    String?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, cutoffAt])
  @@index([businessDate, cutoffAt])
  @@index([createdAt])
  @@map("snapshot_runs")
}

/// Бинарные объекты снимка (вместо S3/локальной папки). Режим SNAPSHOT_STORAGE_MODE=db.
model SnapshotObject {
  id              String   @id @default(cuid())
  key             String   @unique
  body            Bytes
  contentType     String
  contentEncoding String?
  byteSize        Int
  createdAt       DateTime @default(now())

  @@index([key])
  @@map("snapshot_objects")
}

model BankAccountReconciliation {
  id          String                            @id @default(cuid())
  date        DateTime
  isoWeekYear Int // ISO-год недели
  isoWeek     Int // номер ISO-недели (1–53)
  createdAt   DateTime                          @default(now())
  createdBy   String
  results     BankAccountReconciliationResult[]

  @@unique([isoWeekYear, isoWeek])
  @@map("bank_account_reconciliations")
}

model BankAccountReconciliationResult {
  id               String                    @id @default(cuid())
  reconciliationId String
  bankAccountId    String
  foreignAmount    Float? // сумма в валюте счёта (ручной ввод)
  exchangeRate     Float? // курс к рублю (ручной ввод; null для RUB)
  amount           Float? // рублёвый остаток = foreignAmount × exchangeRate
  comment          String? // только для поля «Руб»
  updatedAt        DateTime                  @updatedAt
  reconciliation   BankAccountReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  bankAccount      BankAccount               @relation(fields: [bankAccountId], references: [id])

  @@unique([reconciliationId, bankAccountId])
  @@index([reconciliationId])
  @@index([bankAccountId])
  @@map("bank_account_reconciliation_results")
}

model ProjectVerification {
  id        String                      @id @default(cuid())
  date      DateTime
  createdAt DateTime                    @default(now())
  createdBy String
  results   ProjectVerificationResult[]

  @@map("project_verifications")
}

model ProjectVerificationResult {
  id             String              @id @default(cuid())
  verificationId String
  projectId      String
  checked        Boolean             @default(false)
  comment        String?
  updatedAt      DateTime            @updatedAt
  verification   ProjectVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id])

  @@unique([verificationId, projectId])
  @@index([verificationId])
  @@index([projectId])
  @@map("project_verification_results")
}
